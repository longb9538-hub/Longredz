-- ==================== B52 OANH TẠC LIÊN TỤC THEO ĐỢT (WAVE B52 STRIKE) ====================
B52Btn.MouseButton1Click:Connect(function()
    if b52Active then return end
    b52Active = true
    B52Btn.Text = Strings[currentLang].StrikeActive
    B52Btn.BackgroundColor3 = Color3.fromRGB(50, 25, 15)
    
    local cam = Workspace.CurrentCamera
    cam.CameraType = Enum.CameraType.Scriptable
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local skyPos = (root and root.Position or Vector3.zero) + Vector3.new(0, 3500, 0)
    cam.CFrame = CFrame.new(skyPos, skyPos + Vector3.new(0, -1, -0.01))
    
    task.spawn(function()
        local strikeDuration = 20
        local startTime = tick()
        local usedParts = {}
        
        while b52Active and (tick() - startTime < strikeDuration) do
            local targetsHRP = {}
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    local hum = p.Character:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 then
                        table.insert(targetsHRP, p.Character.HumanoidRootPart)
                    end
                end
            end
            
            local currentParts = scanForSpammedItems()
            local batchParts = {}
            
            for _, part in ipairs(currentParts) do
                if not usedParts[part] and part and part.Parent then
                    table.insert(batchParts, part)
                end
            end
            
            if #targetsHRP > 0 and #batchParts > 0 then
                local waveSize = math.min(#batchParts, 4)
                
                for i = 1, waveSize do
                    local bomb = batchParts[i]
                    usedParts[bomb] = true
                    
                    local targetIndex = math.random(1, #targetsHRP)
                    local assignedTarget = targetsHRP[targetIndex]
                    
                    if assignedTarget and bomb and bomb.Parent then
                        task.spawn(function()
                            bomb.Anchored = false
                            pcall(function() bomb:SetNetworkOwner(LocalPlayer) end)
                            
                            local dropPos = assignedTarget.Position + Vector3.new(math.random(-80, 80), 2200, math.random(-80, 80))
                            bomb.CFrame = CFrame.new(dropPos)
                            
                            local skyPart = Instance.new("Part", Workspace)
                            skyPart.Size = Vector3.new(1, 1, 1)
                            skyPart.Position = dropPos
                            skyPart.Anchored = true
                            skyPart.Transparency = 1
                            
                            local redBeam = Instance.new("Beam", bomb)
                            redBeam.Attachment0 = Instance.new("Attachment", skyPart)
                            redBeam.Attachment1 = Instance.new("Attachment", bomb)
                            redBeam.Color = ColorSequence.new(Color3.fromRGB(255, 50, 50))
                            redBeam.Width0 = 2.0; redBeam.Width1 = 1.0
                            
                            local bStart = tick()
                            while bomb and bomb.Parent and assignedTarget and assignedTarget.Parent do
                                if tick() - bStart > 6 then break end
                                bomb.CanCollide = false
                                local curPos, tgtPos = bomb.Position, assignedTarget.Position
                                if (curPos - tgtPos).Magnitude < 20 then
                                    Instance.new("Explosion", Workspace).Position = bomb.Position
                                    bomb:Destroy()
                                    break
                                else
                                    local dir = (tgtPos - curPos).Unit
                                    bomb.CFrame = CFrame.new(curPos + dir * 380 * 0.03, tgtPos) * CFrame.Angles(math.rad(90), 0, 0)
                                    bomb.AssemblyLinearVelocity = dir * 380
                                end
                                task.wait(0.03)
                            end
                            if skyPart then skyPart:Destroy() end
                        end)
                    end
                end
            end
            
            task.wait(0.5)
        end
        
        b52Active = false
        B52Btn.Text = Strings[currentLang].Strike
        B52Btn.BackgroundColor3 = Color3.fromRGB(35, 20, 15)
        if LocalPlayer.Character then
            cam.CameraType = Enum.CameraType.Custom
            cam.CameraSubject = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        end
    end)
end)

