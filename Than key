local function scanForSpammedItems()
    local availableParts = {}
    for _, b in ipairs(selectedBombs) do
        if b and b.Parent and b:IsA("BasePart") and not b.Anchored then table.insert(availableParts, b) end
    end
    if autoScanSpammed then
        for _, obj in ipairs(Workspace:GetChildren()) do
            if obj:IsA("Tool") then
                for _, child in ipairs(obj:GetDescendants()) do
                    if child:IsA("BasePart") and not child.Anchored then
                        local exists = false
                        for _, p in ipairs(availableParts) do if p == child then exists = true break end end
                        if not exists then table.insert(availableParts, child) end
                    end
                end
            elseif obj:IsA("BasePart") and not obj.Anchored then
                local isValid = true
                for _, p in ipairs(Players:GetPlayers()) do
                    if p.Character and obj:IsDescendantOf(p.Character) then isValid = false break end
                end
                if isValid then
                    local exists = false
                    for _, part in ipairs(availableParts) do if part == obj then exists = true break end end
                    if not exists then table.insert(availableParts, obj) end
                end
            end
        end
    end
    return availableParts
end

