local function executeDeadHandStrike()
    local myChar = LocalPlayer.Character
    if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end
    local myHrp = myChar.HumanoidRootPart
    local enemiesHrp = {}
    
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local enemyHrp = p.Character:FindFirstChild("HumanoidRootPart")
            local enemyHum = p.Character:FindFirstChildOfClass("Humanoid")
            if enemyHrp and enemyHum and enemyHum.Health > 0 and (enemyHrp.Position - myHrp.Position).Magnitude < 500 then
                table.insert(enemiesHrp, enemyHrp)
            end
        end
    end
    
    if #enemiesHrp > 0 then
        local availableParts = scanForSpammedItems()
        for i, targetHrp in ipairs(enemiesHrp) do
            local bomb = availableParts[i] or availableParts[math.random(1, #availableParts)]
            if bomb and bomb.Parent then
                task.spawn(function()
                    bomb.Anchored = false
                    pcall(function() bomb:SetNetworkOwner(LocalPlayer) end)
                    local dropPos = targetHrp.Position + Vector3.new(math.random(-60, 60), 2200, math.random(-60, 60))
                    bomb.CFrame = CFrame.new(dropPos)
                    
                    local startTime = tick()
                    while bomb and bomb.Parent and targetHrp and targetHrp.Parent do
                        if tick() - startTime > 6 then break end
                        bomb.CanCollide = false
                        local curPos, tgtPos = bomb.Position, targetHrp.Position
                        if (curPos - tgtPos).Magnitude < 25 then
                            Instance.new("Explosion", Workspace).Position = bomb.Position
                            break
                        else
                            local dir = (tgtPos - curPos).Unit
                            bomb.CFrame = CFrame.new(curPos + dir * 350 * 0.03, tgtPos) * CFrame.Angles(math.rad(90), 0, 0)
                            bomb.AssemblyLinearVelocity = dir * 350
                        end
                        task.wait(0.03)
                    end
                end)
            end
        end
    end
end

local function showDeadHandPrompt()
    if promptActive then return end
    promptActive = true; promptCancelled = false
    PromptFrame.Visible = true
    task.spawn(function()
        for i = 10, 1, -1 do
            if promptCancelled or not promptActive then break end
            YesBtn.Text = "ĐỒNG Ý (" .. i .. "s)"
            task.wait(1)
        end
        PromptFrame.Visible = false
        if promptActive and not promptCancelled then executeDeadHandStrike() end
        promptActive = false
    end)
end

