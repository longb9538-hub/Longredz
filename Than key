local function updateVision()
    if visionMode == 0 then
        ccEffect.Enabled = false
        VisionBtn.Text = Strings[currentLang].VisNormal
        VisionBtn.BackgroundColor3 = Color3.fromRGB(15, 25, 18)
        for _, hl in pairs(flirHighlights) do if hl and hl.Parent then hl:Destroy() end end
        flirHighlights = {}
    elseif visionMode == 1 then
        ccEffect.Enabled = true
        ccEffect.Brightness = 0.15; ccEffect.Contrast = 0.5; ccEffect.Saturation = -0.1
        ccEffect.TintColor = Color3.fromRGB(100, 255, 120)
        VisionBtn.Text = Strings[currentLang].VisNVG
        VisionBtn.BackgroundColor3 = Color3.fromRGB(15, 45, 25)
        for _, hl in pairs(flirHighlights) do if hl and hl.Parent then hl:Destroy() end end
        flirHighlights = {}
    elseif visionMode == 2 then
        ccEffect.Enabled = true
        ccEffect.Brightness = -0.1; ccEffect.Contrast = 0.4; ccEffect.Saturation = -1
        ccEffect.TintColor = Color3.fromRGB(220, 220, 255)
        VisionBtn.Text = Strings[currentLang].VisFLIR
        VisionBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 50)
    end
end

